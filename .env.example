# Satnam v2 — Environment Variable Reference
# Copy to .env.local for local development.
# For production, set these in Netlify → Site Settings → Environment Variables.
#
# All VITE_* variables are injected into the client bundle at build time.
# Never put secret keys (service_role, API secrets) in VITE_* variables.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project URL (from Project Settings → API → URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key — safe to expose to the browser
# (from Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Primary Nostr relay (Pylon)
VITE_PYLON_RELAY=wss://pylon.openagents.com

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated fallback relay URLs (used when Pylon is unavailable)
# VITE_FALLBACK_RELAYS=wss://relay.damus.io,wss://relay.nostr.band

# Application environment: development | staging | production
# VITE_APP_ENV=development

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to 'true' to enable. All disabled by default for Phase 1.

# NFC NTAG424 client-side CMAC verification (Phase 2, Week 7)
# VITE_ENABLE_NFC=false

# Cashu ecash client (Phase 2, Week 8)
# VITE_ENABLE_CASHU=false

# NIP-90 DVM marketplace (Phase 3, Week 12)
# VITE_ENABLE_NIP90=false

# FROST group key management (Phase 2, Week 5)
# VITE_ENABLE_FROST=false

# v1 → v2 migration ceremony UI (Phase 1, Week 4)
# VITE_ENABLE_MIGRATION=false

# ── Netlify Functions (server-side only — DO NOT use VITE_ prefix) ────────────
# These are set in Netlify environment and are NEVER included in the client bundle.
# Add them directly in Netlify → Site Settings → Environment Variables.
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Used by Netlify functions only
# SUPABASE_URL=https://your-project-ref.supabase.co # Same as VITE_ but server-side alias

# ── Phase 0 Dry-Run (2026-09-27) ──────────────────────────────────────────────
# BRIDGE_URL is Bridgelet public URL — NOT SERVICE_URL (avoids reverse_proxy cert churn on satnam.pub)
# VITE_BRIDGE_URL=https://bridge.satnam.pub
# Feature flags — Phase 0 pure CLINK dry-run
# VITE_ENABLE_CLINK=true
# VITE_ENABLE_BOT_MOTHER=true
# VITE_ENABLE_LNBITS=false
# VITE_ENABLE_LNURL=false
# VITE_DRY_RUN=true
# VITE_BOT_MOTHER_POW_REQUIRED=true
# Bot-Mother relay — Phase 0 dry uses your StrFry, Phase 0 live flips to relay.shock.network
# VITE_BOT_MOTHER_RELAY=wss://relay.satnam.pub
# NWC BYO — users paste nostr+walletconnect:// URIs; no Alby SDK wired (paste any wallet's NWC)
# VITE_ENABLE_NWC_BYO=true
